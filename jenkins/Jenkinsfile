pipeline {
    agent any
    
    tools {
        git 'Default'
        jdk 'myjdk'
        maven 'mymaven'
    }
    stages {
        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
            post{
                success {
                    archiveArtifacts artifacts: '**/target/*.jar', fingerprint: true
                }
            }
        }
        stage('Test') {
            steps {
                sh 'mvn test'
            }
             
        }
        stage('Deliver') { 
            steps {
                sh 'mvn deploy'
            }
        }
    }
}

